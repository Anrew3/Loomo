<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	The crimp tool in the App Store build. MCP clients launch it on their own, so it is sandboxed in its own
	right and joins the app's App Group to reach the live-editing socket. The build phase that signs crimp
	fills in $(TeamIdentifierPrefix), because codesign doesn't expand build settings.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)com.loomo.shared</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
